# Release configuration for the static export. Both values may stay empty: the site then builds,
# publishes and works as a free historical-analysis site with payments and sign-in suppressed.
#
# HTTPS origin of the operator-run companion service (operator/). Only an origin the operator
# controls and has authorized; it must allow this site's origin (IMD_SPORT_ALLOWED_ORIGIN).
VITE_COMPANION_ORIGIN=
# WalletConnect Cloud project ID registered by the builder/operator for this site. Empty hides the row.
VITE_WALLETCONNECT_PROJECT_ID=
